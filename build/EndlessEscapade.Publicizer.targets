<Project>

    <PropertyGroup>
        <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
    </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" PrivateAssets="true" Version="2.2.1"/>
	</ItemGroup>

	<ItemGroup>
		<Publicize Include="FNA" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="ReLogic" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="tModLoader" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
	</ItemGroup>

</Project>
